@prefix :    <http://example.org/gorgonaut#> .
@prefix gorgo: <http://example.org/gorgonaut#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

@base <http://example.org/gorgonaut/shapes> .

<http://example.org/gorgonaut/shapes> a owl:Ontology ;
    rdfs:label "Gorgonaut / Mind Tools SHACL shapes"@en ;
    rdfs:comment "SHACL shapes graph for validating gorgonaut-mindtools.ttl data."@en .

:NamedEntityShape a sh:NodeShape ;
    sh:property [
        sh:path :hasName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every entity must have exactly one :hasName (string)."@en
    ] ;
    sh:property [
        sh:path :hasDescription ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Description, if present, must be a string."@en
    ] .


